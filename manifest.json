{
  "manifest_version": 3,
  "name": "Discord → NotebookLM",
  "version": "0.2.0",
  "description": "Discordのチャット履歴をNotebookLMにインポート。トークン入力でAPI経由でもDOMスクレイピングでも取得可能。",
  "action": {
    "default_title": "Discord → NotebookLM",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "clipboardWrite",
    "downloads",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://discord.com/*",
    "https://notebooklm.google.com/*",
    "https://notebooklm.google/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://discord.com/channels/*"],
      "js": ["shared.js", "discord-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://notebooklm.google.com/*",
        "https://notebooklm.google/*"
      ],
      "css": ["notebooklm-panel.css"],
      "js": ["notebooklm-content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}